# Runtime Environment
NODE_ENV=development
PORT=8080
BASE_URL=http://localhost:8080
DATA_DIR=./data
LOG_LEVEL=info

# Production Requirements
# generate with: openssl rand -hex 32
ADMIN_TOKEN=
ENCRYPTION_KEY=

# Google OAuth Integration (Optional in M1)
GOOGLE_CLIENT_ID=placeholder-client-id
GOOGLE_CLIENT_SECRET=placeholder-client-secret
HOST_EMAIL=host@example.com

# Calendar Feeds (Optional in M1)
BUSY_CALENDARS=host@example.com,family@example.com
ICS_FEEDS=webcal://example.com/feed
ICS_BLOCK_ALL_DAY=1

# External Meeting Links
ZOOM_LINK=https://zoom.us/j/placeholder

# Cloudflare Turnstile (Optional in M1)
TURNSTILE_SITE_KEY=placeholder-site-key
TURNSTILE_SECRET=placeholder-secret

# Webhooks (Optional)
WEBHOOK_URL=
WEBHOOK_SECRET=
