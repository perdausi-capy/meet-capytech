# Copy to .env. Everything left blank is optional in development; the app runs without
# Google, iCal feeds or Turnstile and books into the local SQLite database only.
# Lines marked [prod] are required when NODE_ENV=production (the app refuses to start otherwise).

# --- Runtime ---
# `npm run dev` always runs in development mode; docker-compose.yml forces production.
NODE_ENV=development
PORT=8080
# [prod] Public URL, used in manage links and the Google OAuth redirect.
BASE_URL=http://localhost:8080
# SQLite location. docker-compose.yml overrides this to /data inside the container.
DATA_DIR=./data
LOG_LEVEL=info

# --- Secrets ---
# [prod] openssl rand -hex 32   (min 32 chars; used by the CRM and to log in at /admin)
ADMIN_TOKEN=
# [prod] openssl rand -hex 32   (exactly 64 hex chars; encrypts Google tokens at rest)
ENCRYPTION_KEY=

# --- Google Calendar (optional) ---
# Without a connected Google account, development books locally only, while production
# refuses to offer slots (fail closed). Connect once via /admin after setting these.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
HOST_EMAIL=
# Extra calendar IDs to read free/busy from (comma separated). The primary calendar is always read.
BUSY_CALENDARS=

# --- iCloud / other iCal feeds (optional, secret URLs) ---
ICS_FEEDS=
ICS_BLOCK_ALL_DAY=1

# --- Meeting links (optional) ---
ZOOM_LINK=

# --- Cloudflare Turnstile (optional; set both or neither) ---
# Strongly recommended in production: without it, anyone can script bookings that send
# invites from the host's calendar. The site key's hostname list must include BASE_URL's host.
# Cloudflare test keys (always pass): 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# --- Email (optional in development) ---
# Leave SMTP_HOST blank in development: emails are written to DATA_DIR/outbox/*.eml instead.
# Production uses Amazon SES in London (see docs §4.8). Without SMTP, production skips emails.
SMTP_HOST=
# email-smtp.eu-west-2.amazonaws.com in production
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Required when SMTP_HOST is set, e.g. "Jason at Capytech UK <meet@capytech.co.uk>"
EMAIL_FROM=
EMAIL_REPLY_TO=

# --- Backups ---
# Nightly copies at 03:00 London in DATA_DIR/backups; copy that folder off the server too.
BACKUP_RETENTION_DAYS=14

# --- CRM webhooks (optional) ---
WEBHOOK_URL=
# [prod, if WEBHOOK_URL is set] min 32 chars
WEBHOOK_SECRET=

# --- Development only ---
# Set to 1 to fake one busy hour per day instead of calling Google. Never use in production.
# MOCK_CALENDAR=1
